{
  "name": "@abcheckout/core",
  "version": "0.1.0",
  "description": "Superficie drop-in de pagamento Pix. Vanilla, zero dependencia de runtime.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.mts",
      "import": "./dist/locales/en.mjs"
    },
    "./styles": {
      "types": "./dist/styles.d.mts",
      "import": "./dist/styles.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "unpkg": "./dist/abcheckout.global.js",
  "scripts": {
    "build": "tsdown",
    "size": "size-limit"
  },
  "size-limit": [
    { "name": "checkout-core (esm)", "path": "dist/index.mjs", "limit": "12 kB", "gzip": true },
    { "name": "checkout-core (iife/cdn)", "path": "dist/abcheckout.global.js", "limit": "12 kB", "gzip": true }
  ],
  "license": "MIT"
}
